{
  "name": "head-de-interacao",
  "version": "1.0.0",
  "description": "MCP para criar sites imersivos (scroll cinematográfico) do zero ou transformar sites existentes — funciona em Claude Code, Codex, Antigravity, Gemini CLI, Cursor, VS Code e qualquer cliente MCP.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "scroll",
    "imersivo",
    "immersive",
    "awwwards",
    "website",
    "frames",
    "scrollytelling",
    "claude",
    "codex",
    "antigravity",
    "gemini",
    "cursor"
  ],
  "homepage": "https://github.com/holaluiz/mcp_head_de_interacao#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/holaluiz/mcp_head_de_interacao.git"
  },
  "bugs": {
    "url": "https://github.com/holaluiz/mcp_head_de_interacao/issues"
  },
  "license": "MIT",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "head-de-interacao": "src/index.js"
  },
  "files": [
    "src/",
    "engine/",
    "templates/",
    "scripts/",
    "docs/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node src/index.js",
    "test": "node test/smoke.mjs",
    "test:rapido": "node test/smoke.mjs --rapido",
    "build:engine": "node scripts/build-engine.mjs",
    "configurar": "node scripts/configurar.mjs"
  },
  "engines": {
    "node": ">=18.17"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "cheerio": "^1.2.0",
    "lenis": "^1.3.27",
    "zod": "^3.25.0"
  },
  "optionalDependencies": {
    "puppeteer-core": "^25.14.0"
  }
}
